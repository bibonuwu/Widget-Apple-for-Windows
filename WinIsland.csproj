<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WinIsland</AssemblyName>
    <RootNamespace>WinIsland</RootNamespace>
    <Version>1.1.0</Version>
    <!-- без хвоста «+хеш коммита» в версии продукта -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>WinIsland</Product>
    <!-- создатель: виден в свойствах файла и в колонке «Издатель» Диспетчера задач -->
    <Company>Bibon</Company>
    <Authors>Bibon</Authors>
    <Copyright>© 2026 Bibon</Copyright>
    <ApplicationIcon>Assets\WinIsland.ico</ApplicationIcon>
    <!-- установщик — отдельный проект в Setup\, его файлы сюда не входят -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Setup\**;publish\**;dist\**</DefaultItemExcludes>

    <!-- лёгкий режим: минимум памяти и потоков -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
