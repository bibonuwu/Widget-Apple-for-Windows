<Window x:Class="WinIslandSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка WinIsland" Width="480" Height="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#FFF2F2F7">

    <Window.Resources>
        <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Secondary" Color="#FF98989F"/>
        <SolidColorBrush x:Key="Panel" Color="#FF2C2C2E"/>
        <SolidColorBrush x:Key="Line" Color="#1AFFFFFF"/>
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut"/>
        <BackEase x:Key="Spring" EasingMode="EaseOut" Amplitude="0.4"/>

        <!-- Большая кнопка как в iOS -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF0A84FF"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="13" Background="{TemplateBinding Background}"/>
                            <Border x:Name="Hl" CornerRadius="13" Background="White" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.12"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Hl" Property="Opacity" Value="0.22"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#FFFF453A"/>
        </Style>
        <Style x:Key="TextBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF0A84FF"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Height" Value="40"/>
        </Style>

        <!-- Круглая кнопка «закрыть» -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg" Fill="#33000000"/>
                            <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Icons}" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#59000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель как в iOS -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF2F2F7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Margin="0,0,16,0" RecognizesAccessKey="False"/>
                            <Grid Grid.Column="1" Width="48" Height="29" VerticalAlignment="Center">
                                <Border CornerRadius="14.5" Background="#FF48484A"/>
                                <Border x:Name="On" CornerRadius="14.5" Background="#FF30D158" Opacity="0"/>
                                <Ellipse x:Name="Knob" Width="25" Height="25" Fill="White"
                                         HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.3"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="19" Duration="0:0:0.34" EasingFunction="{StaticResource Spring}"/>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Knob"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0.34" EasingFunction="{StaticResource Spring}"/>
                                            <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="18"/>
        </Style>
        <Style x:Key="Page" TargetType="Grid">
            <Setter Property="Margin" Value="28,4,28,26"/>
            <Setter Property="Visibility" Value="Collapsed"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <!-- тень отдельно от карточки, чтобы текст оставался чётким -->
        <Border Margin="20" CornerRadius="18" Background="#FF1C1C1E">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.5"/>
            </Border.Effect>
        </Border>

        <Border x:Name="Card" Margin="20" CornerRadius="18" Background="#FF1C1C1E"
                BorderBrush="#24FFFFFF" BorderThickness="1" MouseLeftButtonDown="Card_MouseDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ===== Шапка: «остров» на градиенте ===== -->
                <Grid x:Name="Hero">
                    <!-- скруглённая маска по форме карточки (внизу всё равно уходит в цвет карточки) -->
                    <Grid.Clip>
                        <RectangleGeometry Rect="0,0,438,150" RadiusX="17" RadiusY="17"/>
                    </Grid.Clip>
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF3B2A86" Offset="0"/>
                                <GradientStop Color="#FF173A7A" Offset="0.6"/>
                                <GradientStop Color="#FF0F4C8A" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Ellipse Width="320" Height="200" Margin="-140,-90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#667C5CFF" Offset="0"/>
                                <GradientStop Color="#007C5CFF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="300" Height="220" Margin="0,0,-120,-120" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#5512A0FF" Offset="0"/>
                                <GradientStop Color="#0012A0FF" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <!-- плавный переход в цвет карточки -->
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#001C1C1E" Offset="0.4"/>
                                <GradientStop Color="#FF1C1C1E" Offset="0.86"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- сам остров -->
                    <Border x:Name="HeroPill" Width="64" Height="22" CornerRadius="23" Background="Black"
                            HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="22" ShadowDepth="6" Direction="270" Opacity="0.45"/>
                        </Border.Effect>
                        <Grid x:Name="HeroContent" Opacity="0" Margin="7,0,16,0">
                            <Border Width="32" Height="32" CornerRadius="9" HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFF5E7E" Offset="0"/>
                                        <GradientStop Color="#FF8A3CFF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Ellipse Width="13" Height="13" Fill="#66FFD6A8" Margin="12,0,0,10"/>
                            </Border>
                            <StackPanel Margin="44,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Сейчас играет" FontSize="10.5" Foreground="#FF8E8E93"/>
                                <TextBlock Text="WinIsland" FontSize="12.5" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                            <StackPanel x:Name="Eq" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Height="16">
                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#FF30D158"/>
                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#FF30D158" Margin="2.5,0,0,0"/>
                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#FF30D158" Margin="2.5,0,0,0"/>
                                <Rectangle Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="#FF30D158" Margin="2.5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button x:Name="CloseBtn" Style="{StaticResource CloseBtn}" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,14,14,0" Click="Close_Click" ToolTip="Закрыть"/>
                </Grid>

                <!-- ===== Название ===== -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock Text="WinIsland" FontSize="27" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="Subtitle" Text="Динамический остров для Windows" FontSize="13"
                               Foreground="{StaticResource Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <Grid Grid.Row="2">

                    <!-- ===== 1. Приветствие ===== -->
                    <Grid x:Name="PageWelcome" Style="{StaticResource Page}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <Border Background="{StaticResource Panel}" CornerRadius="13">
                                <StackPanel>
                                    <Grid Margin="16,12,16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xED25;" FontFamily="{StaticResource Icons}" FontSize="16"
                                                   Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Папка установки" FontSize="14"/>
                                            <TextBlock x:Name="PathText" FontSize="12" Foreground="{StaticResource Secondary}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="44,0,0,0"/>
                                    <CheckBox x:Name="DesktopSwitch" Style="{StaticResource Switch}" Margin="16,10,14,10" IsChecked="True">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource Icons}" FontSize="16"
                                                       Foreground="#FF0A84FF" VerticalAlignment="Center"/>
                                            <TextBlock Text="Ярлык на рабочем столе" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>
                            <Grid x:Name="RuntimeNote" Margin="4,14,4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="13"
                                           Foreground="{StaticResource Secondary}" Margin="0,2,8,0"/>
                                <TextBlock Grid.Column="1" Style="{StaticResource Note}" x:Name="RuntimeText"/>
                            </Grid>
                        </StackPanel>
                        <Button x:Name="InstallBtn" Grid.Row="1" Style="{StaticResource Btn}" Content="Установить" Click="Install_Click"/>
                    </Grid>

                    <!-- ===== 2. Процесс ===== -->
                    <Grid x:Name="PageProgress" Style="{StaticResource Page}">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,0,30">
                            <TextBlock x:Name="ProgressTitle" Style="{StaticResource Title}" Text="Устанавливаю…"/>
                            <Grid x:Name="BarTrack" Height="6" Margin="0,16,0,0" ClipToBounds="True">
                                <Border Background="#FF3A3A3C" CornerRadius="3"/>
                                <Border x:Name="BarFill" Background="#FF0A84FF" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="BarShift"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock x:Name="ProgressText" Style="{StaticResource Note}" Margin="0,10,0,0" Text=" "/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== 3. Готово + предложение автозагрузки ===== -->
                    <Grid x:Name="PageDone" Style="{StaticResource Page}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,14">
                                <Grid Width="26" Height="26">
                                    <Ellipse Fill="#FF30D158"/>
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock x:Name="DoneTitle" Style="{StaticResource Title}" Text="WinIsland установлен"
                                           Margin="11,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Background="{StaticResource Panel}" CornerRadius="13">
                                <StackPanel>
                                    <CheckBox x:Name="AutostartSwitch" Style="{StaticResource Switch}" Margin="16,12,14,12" IsChecked="True">
                                        <StackPanel>
                                            <TextBlock Text="Запускать вместе с Windows"/>
                                            <TextBlock Text="Остров будет появляться сам после включения компьютера"
                                                       FontSize="12" Foreground="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Border Height="1" Background="{StaticResource Line}" Margin="16,0,0,0"/>
                                    <CheckBox x:Name="LaunchSwitch" Style="{StaticResource Switch}" Margin="16,12,14,12" IsChecked="True"
                                              Content="Открыть WinIsland сейчас"/>
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Note}" Margin="4,14,4,0"
                                       Text="Тёмную или светлую тему и автозапуск можно поменять позже — правый клик по иконке WinIsland в трее."/>
                        </StackPanel>
                        <Button x:Name="DoneBtn" Grid.Row="1" Style="{StaticResource Btn}" Content="Готово" Click="Done_Click"/>
                    </Grid>

                    <!-- ===== Удаление: подтверждение ===== -->
                    <Grid x:Name="PageUninstall" Style="{StaticResource Page}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Title}" Text="Удалить WinIsland?"/>
                            <TextBlock Style="{StaticResource Note}" FontSize="13" Margin="0,8,0,0"
                                       Text="Будут удалены программа, ярлыки, автозапуск и настройки, включая выбранную тему."/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button x:Name="UninstallBtn" Style="{StaticResource DangerBtn}" Content="Удалить" Click="Uninstall_Click"/>
                            <Button Style="{StaticResource TextBtn}" Content="Отмена" Margin="0,6,0,-8" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- ===== Удаление: готово ===== -->
                    <Grid x:Name="PageRemoved" Style="{StaticResource Page}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                <Grid Width="26" Height="26">
                                    <Ellipse Fill="#FF636366"/>
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Title}" Text="WinIsland удалён" Margin="11,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Note}" FontSize="13" Margin="0,10,0,0"
                                       Text="Спасибо, что пользовались! Вернуть остров можно, снова запустив установщик."/>
                        </StackPanel>
                        <Button x:Name="RemovedCloseBtn" Grid.Row="1" Style="{StaticResource Btn}" Content="Закрыть" Click="Close_Click"/>
                    </Grid>

                    <!-- ===== Ошибка ===== -->
                    <Grid x:Name="PageError" Style="{StaticResource Page}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                <Grid Width="26" Height="26">
                                    <Ellipse Fill="#FFFF453A"/>
                                    <TextBlock Text="!" FontSize="16" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                                </Grid>
                                <TextBlock Style="{StaticResource Title}" Text="Не получилось" Margin="11,0,0,1" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ErrorText" Style="{StaticResource Note}" FontSize="13" Margin="0,10,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <Button x:Name="RetryBtn" Style="{StaticResource Btn}" Content="Попробовать ещё раз" Click="Retry_Click"/>
                            <Button Style="{StaticResource TextBtn}" Content="Закрыть" Margin="0,6,0,-8" Click="Close_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
